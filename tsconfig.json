{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@earendil-works/pi-ai": ["./node_modules/@earendil-works/pi-ai"]
    },
    "types": ["node"]
  },
  "include": ["index.ts", "src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "upstream-tests", "node_modules"]
}
